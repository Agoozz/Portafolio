# --- Configuración del Backend ---
PORT=3000

# --- Inteligencia Artificial ---
# Reemplaza con tu clave de API de Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_key_here

# --- Seguridad ---
# Si despliegas a producción, especifica el dominio de tu frontend (ej: https://mi-portafolio.com)
# En desarrollo local: ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
